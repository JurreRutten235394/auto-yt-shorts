OPENAI_API_KEY_AUTO_YT_SHORTS=<YOUR_OPENAI_API_KEY>
PEXELS_API_KEY=<YOUR_PEXELS_API_KEY>
ASSEMBLY_AI_API_KEY=<YOUR_ASSEMBLY_AI_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

CRON_SCHEDULE="0 12 * * *"
RUN_ONCE="false"
VIDEO_COUNT="1"

# Language of the titles and voiceover, sent to YouTube with each upload
# VIDEO_LANGUAGE=en

# Set to "true" if videos contain realistic AI-generated or altered footage,
# to apply YouTube's altered or synthetic content disclosure
# CONTAINS_SYNTHETIC_MEDIA=false

# Videos are compared on their stats from this many days after upload
# ANALYTICS_WINDOW_DAYS=3

# Overlay a clip from secondary_video/ on each video. Only enable this for
# footage you made yourself: Shorts made of reused clips get less reach.
# USE_SECONDARY_VIDEO=false

# Set to "true" to approve videos with `python review.py` before they're uploaded
# REVIEW_BEFORE_UPLOAD=false
